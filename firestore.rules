rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — PROPUESTA V00435 (app móvil: operadores y clientes)
// ═══════════════════════════════════════════════════════════════════════════
//  ⚠ ANTES DE PUBLICAR: compara con las reglas que hoy tienes en la consola
//    (Firestore › Reglas). Esta propuesta asume que hoy el personal puede leer y
//    escribir todo estando autenticado (`request.auth != null`). Si tus reglas
//    actuales tienen restricciones por colección, CONSÉRVALAS y solo agrega la
//    condición `esPersonal()` en lugar de `request.auth != null`.
//
//  Qué cambia:
//   1) Un usuario con usuarios/{uid}.tipoUsuario == 'cliente' NO puede leer ni
//      escribir ninguna colección. Sus datos le llegan por la Cloud Function
//      `portalCliente`, que filtra los campos (nunca ve costos ni sueldos).
//   2) "Personal" = autenticado + CON documento en `usuarios` + no cliente.
//      Esto además cierra un hueco: hoy un usuario al que se le borró su
//      documento en Usuarios ("eliminar acceso") conserva su cuenta de Auth y,
//      con `auth != null`, podría seguir leyendo la base con el SDK.
//   3) Cada usuario puede leer SU propio perfil, y el cliente solo puede
//      actualizar sus campos de último acceso desde la app.
//
//  Costo: cada petición del personal hace 1 lectura extra (su perfil), que
//  Firestore cachea durante la evaluación de esa petición.
//
//  OJO también con las Cloud Functions: escriben como ADMIN y no pasan por
//  estas reglas. Por eso la V00435 agrega exigirPersonal() a crearOperacion,
//  renumerarOperacion y verificarIntegridad (functions/src/acceso.ts).
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function tienePerfil() {
      return exists(rutaPerfil());
    }

    function perfil() {
      return get(rutaPerfil()).data;
    }

    // Tolerante a mayúsculas/espacios ('Cliente ', 'CLIENTE'…), igual que la app y la función.
    function esCliente() {
      return tienePerfil()
        && perfil().get('tipoUsuario', '') is string
        && perfil().get('tipoUsuario', '').trim().lower() == 'cliente';
    }

    // Un perfil con activo == false queda sin acceso (hoy todos se crean con activo: true).
    function estaActivo() {
      return perfil().get('activo', true) != false;
    }

    // Personal de Roelca: sistema web y operadores de la app móvil.
    function esPersonal() {
      return autenticado() && tienePerfil() && !esCliente() && estaActivo();
    }

    // ── Todo el sistema: solo personal (mismo alcance que hoy) ──
    match /{document=**} {
      allow read, write: if esPersonal();
    }

    // ── Perfil propio (la app lo lee al iniciar sesión para saber qué mostrar) ──
    match /usuarios/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow update: if autenticado()
        && request.auth.uid == uid
        && esCliente()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ultimoAccesoMovil', 'plataformaMovil', 'versionAppMovil']);
    }
  }
}
