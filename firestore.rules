rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — V00437 (Fase 1.4)
// ═══════════════════════════════════════════════════════════════════════════
//  ⚠ PUNTO DE PARADA P1 (PLAN-REFACTOR.md): NO publicar hasta que
//    1) estén desplegadas las funciones de la V00437 (usuarioEscrito, sincronizarClaims),
//    2) un admin haya presionado "🔐 Sincronizar permisos" en Usuarios, y
//    3) `npm run test:rules` pase en verde.
//    Publicar: firebase deploy --only firestore:rules
//
//  Quién es quién (custom claims que pone el servidor desde usuarios/{uid}):
//    · personal → sistema web y operadores de la app móvil.
//    · admin    → personal con rol ADMIN (las reglas lo revisan SIEMPRE en el documento).
//    · cliente  → solo app móvil; no lee colecciones (todo por la callable portalCliente).
//  Transición: un usuario cuyo token aún no trae claims se valida leyendo su
//  documento (1 lectura extra por petición, como en la V00435). Con claims no
//  se lee nada extra.
//
//  Qué cambia respecto a "todo el personal puede todo":
//    · Sin documento en `usuarios`, desactivado o de cliente → nada.
//    · Nadie puede cambiarse sus propios roles: en su perfil solo puede tocar
//      campos de sesión (isOnline, ultimoAcceso, foto, datos de la app móvil).
//    · Usuarios, roles, autorizaciones y configuración de seguridad → solo admin.
//    · Bitácora (historial_actividad): solo se agregan registros; nadie los edita
//      ni borra desde el navegador.
//    · meta/* lo escriben solo las Cloud Functions.
//  Las Cloud Functions usan el Admin SDK y no pasan por estas reglas.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function token() {
      return request.auth.token;
    }

    // El token todavía no trae los claims de Roelca (usuario sin sincronizar).
    function sinClaims() {
      return !('personal' in token());
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function perfil() {
      return get(rutaPerfil()).data;
    }

    // Tolerante a mayúsculas/espacios ('Cliente ', 'CLIENTE'…), igual que la app.
    function perfilEsPersonal() {
      return exists(rutaPerfil())
        && !(perfil().get('tipoUsuario', '') is string && perfil().get('tipoUsuario', '').trim().lower() == 'cliente')
        && perfil().get('activo', true) != false;
    }

    function esPersonal() {
      return autenticado() && (
        token().get('personal', false) == true
        || (sinClaims() && perfilEsPersonal())
      );
    }

    // El perfil sigue existiendo. Se exige en TODAS las escrituras: si un admin
    // borra al usuario, deja de escribir al instante aunque su token (≤1 h) siga
    // diciendo `personal`. Cuesta 1 lectura por escritura; las lecturas confían en
    // el claim (un usuario dado de baja puede LEER hasta 1 h: compromiso documentado).
    function perfilVigente() {
      return exists(rutaPerfil());
    }

    // Admin SIEMPRE con el documento (no con el claim): quitarle el rol a alguien
    // surte efecto al instante. Las escrituras de admin son pocas.
    function esAdmin() {
      return autenticado() && perfilEsPersonal()
        && perfil().get('roles', []).hasAny(['ADMIN', 'Admin', 'admin']);
    }

    // Colecciones que el personal NO escribe por la regla general (tienen la suya abajo).
    function protegida(coleccion) {
      return coleccion in ['usuarios', 'roles', 'config_autorizaciones', 'configuracion', 'meta', 'historial_actividad'];
    }

    // Campos de SU perfil que un usuario puede cambiar (sesión y app móvil).
    function camposPropiosPermitidos() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isOnline', 'ultimoAcceso', 'fotoPerfil', 'ultimoAccesoMovil', 'plataformaMovil', 'versionAppMovil']);
    }

    // ── Regla general: todo el sistema para el personal ──
    match /{coleccion}/{resto=**} {
      allow read: if esPersonal();
      allow write: if esPersonal() && perfilVigente() && !protegida(coleccion);
    }

    // ── Usuarios ──
    match /usuarios/{uid} {
      // Cada quien lee su perfil (también los clientes de la app móvil).
      allow read: if autenticado() && request.auth.uid == uid;
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (autenticado() && request.auth.uid == uid && camposPropiosPermitidos());
    }

    // ── Roles y reglas de autorización: solo admin ──
    match /roles/{id} {
      allow write: if esAdmin();
    }
    match /config_autorizaciones/{id} {
      allow write: if esAdmin();
    }

    // ── Configuración: seguridad y banderas solo admin; metas y obligatorios, personal ──
    match /configuracion/{id} {
      allow write: if esAdmin()
        || (esPersonal() && perfilVigente() && id in ['metas_operaciones', 'metas_globales', 'obligatorios_formulario_tarifa', 'empresa']);
    }

    // ── Bitácora: solo agregar, con el usuario de la sesión ──
    match /historial_actividad/{id} {
      allow create: if esPersonal() && perfilVigente();
    }

    // ── meta/*: lo escriben las Cloud Functions (versiones de catálogos, reportes) ──
    // (lectura por la regla general; escritura: nadie desde el navegador)
  }
}
