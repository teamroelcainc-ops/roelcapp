{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:emulador": "firebase emulators:exec --only firestore --project demo-roelca \"vitest run -c vitest.emulador.config.ts\"",
    "build:scripts": "node ../scripts/sincronizar-dominio.mjs && tsc -p tsconfig.scripts.json",
    "migrar:v2": "npm run build:scripts && node lib-scripts/scripts/migrarEsquemaV2.js",
    "reconciliar": "npm run build:scripts && node lib-scripts/scripts/reconciliarFacturas.js",
    "saldos:diesel": "npm run build:scripts && node lib-scripts/scripts/reconstruirSaldosDiesel.js",
    "usos": "npm run build:scripts && node lib-scripts/scripts/recontarUsos.js",
    "nombres": "npm run build:scripts && node lib-scripts/scripts/propagarNombres.js",
    "revisar:tc": "npm run build:scripts && node lib-scripts/scripts/revisarTipoCambio.js",
    "facturas:texto": "npm run build:scripts && node lib-scripts/scripts/facturasTexto.js",
    "folios": "npm run build:scripts && node lib-scripts/scripts/folioEnOperaciones.js",
    "prebuild": "node ../scripts/sincronizar-dominio.mjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "private": true
}
