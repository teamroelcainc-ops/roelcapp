rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  REGLAS DE STORAGE — V00437 (Fase 1.4)
//  ⚠ Mismo punto de parada que firestore.rules (P1 en PLAN-REFACTOR.md).
//  Publicar: firebase deploy --only storage
//  · Personal (claim `personal`, o perfil válido mientras no haya claims) → todo.
//  · Clientes de la app móvil → nada directo (abren facturas con su enlace de
//    descarga, que trae su propio token y no pasa por estas reglas).
//  ⚠ La regla de respaldo consulta Firestore desde Storage: al publicarla, la
//    consola pide permiso para que Storage lea Firestore. ACÉPTALO; si no, se
//    niegan las subidas de los usuarios sin claims.
// ═══════════════════════════════════════════════════════════════════════════
service firebase.storage {
  match /b/{bucket}/o {

    function sinClaims() {
      return !('personal' in request.auth.token);
    }

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function perfilEsPersonal() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && !(perfil().get('tipoUsuario', '') is string && perfil().get('tipoUsuario', '').trim().lower() == 'cliente')
        && perfil().get('activo', true) != false;
    }

    function esPersonal() {
      return request.auth != null && (
        request.auth.token.get('personal', false) == true
        || (sinClaims() && perfilEsPersonal())
      );
    }

    match /{allPaths=**} {
      allow read, write: if esPersonal();
    }
  }
}
